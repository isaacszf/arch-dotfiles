+    print "Usage: temperature [-w <warning>] [-c <critical>]\n";
+    print "                   [--cpu-chip <chip>] [--gpu-chip <chip>]\n";
+    print "                   [--cpu-input <feature>] [--gpu-input <feature>]\n";
+    print "-w <degrees>: warning threshold to become yellow\n";
